# Sitemap Builder settings.
#
# Copy this file to .env and set the values that you need. .env is not in git.
# The web server denies access to both files (the dotfile rule in .htaccess).
# A real environment variable with the same name wins over a line in this file.
# All keys are optional. A blank value is the same as a missing key.

# ---- Analytics ----
# Each tracker is off until you set its keys. Both can be on at the same time.
# The trackers record page views, the sitemap address that a user loads, and the features that a user uses.

# Google Analytics 4 measurement ID, for example G-AB12CD34EF.
SMB_GA_ID=

# Matomo: the https address of your Matomo installation, and the numeric site ID.
SMB_MATOMO_URL=
SMB_MATOMO_SITE_ID=

# 1 permits tracking cookies. 0 (the default) makes both trackers cookieless:
# Matomo gets disableCookies, and Google Analytics gets consent mode with analytics_storage denied.
SMB_ANALYTICS_COOKIES=0

# ---- Proxy (api/fetch.php) ----
# The defaults are in src/config.php. Set a key only to change it.

# Hosts that the proxy never downloads from: your own host and its subdomains. Comma separated.
SMB_OWN_HOSTS=sitemapbuilder.co.uk

# The largest sitemap file that the proxy relays, in bytes.
SMB_MAX_BYTES=15728640
# Redirects that the proxy follows for one download.
SMB_MAX_REDIRECTS=3
# cURL timeouts in seconds.
SMB_CONNECT_TIMEOUT=5
SMB_TOTAL_TIMEOUT=20

# Rate limits for each client address: requests in a window, and bytes in a window (seconds).
SMB_RATE_WINDOW=300
SMB_RATE_REQUESTS=60
SMB_BYTES_WINDOW=3600
SMB_BYTES_LIMIT=209715200
# Requests in the rate window for all clients together.
SMB_GLOBAL_REQUESTS=600
