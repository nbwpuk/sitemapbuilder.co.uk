# sitemapbuilder.co.uk - the repository root is the web root.
# Keep the Content-Security-Policy below the same as the copy in tests/router.php.

Options -Indexes
DirectoryIndex index.php
AddDefaultCharset utf-8
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Private paths. .well-known stays open for AutoSSL certificate checks.
    RewriteRule ^\.well-known/ - [L]
    RewriteRule (^|/)\. - [R=404,L]
    RewriteRule ^(src|var|tests)(/|$) - [R=404,L,NC]
    RewriteRule \.(md|sh|ini|json|lock|log|sql|bak|orig|swp)$ - [R=404,L,NC]

    # The proxy is the only file in api/ that the web can call.
    RewriteCond %{REQUEST_URI} !^/api/fetch\.php$
    RewriteRule ^api(/|$) - [R=404,L,NC]

    # Cache busting: /assets/v-<hash>/js/app.js -> /assets/js/app.js
    # Relative module imports and CSS url() values stay below the same prefix.
    RewriteRule ^assets/v-[0-9a-f]+/(.+)$ assets/$1 [L,E=VERSIONED:1]
</IfModule>

# Second layer if mod_rewrite is not available.
<IfModule mod_alias.c>
    RedirectMatch 404 ^/(\.git|\.claude|src|var|tests)(/|$)
</IfModule>
<FilesMatch "^\.|\.(md|sh|ini|json|lock|log|sql|bak|orig|swp)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"

    # Default: always revalidate (PHP responses keep their own value). Versioned assets: one year.
    Header setifempty Cache-Control "no-cache"
    Header set Cache-Control "public, max-age=31536000, immutable" env=VERSIONED
    Header set Cache-Control "public, max-age=31536000, immutable" env=REDIRECT_VERSIONED
</IfModule>

<IfModule mod_mime.c>
    AddType text/javascript .js
    AddType image/svg+xml .svg
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript image/svg+xml
</IfModule>

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
   php_value error_log "/home/encodetr/logs/php.sitemap.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home/encodetr/logs/php.sitemap.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
